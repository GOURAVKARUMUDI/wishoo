# Vercel Environment Variables
# Set these in Vercel Project Settings > Environment Variables

# Password Gate
ACCESS_PASSWORD=mahii
# Developer/test login. If entered, it enables the birthday DEV skip even on deployed Vercel.
DEV_ACCESS_PASSWORD=tinku

# Vercel Blob Storage
BLOB_STORE_ID="store_rwYd6x4SMIqldVjl"
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_rwYd6x4SMIqldVjl_g3VsVOXrkzWaf0SBzLB77r4EjiCK0L"

# Session signing secret (HMAC-SHA256, Layer 1 auth for /api/photo).
# Always set a strong random value in production — falls back to
# ACCESS_PASSWORD only for local dev convenience.
MAHII_WORLD_SESSION_SECRET=

# Set to 'true' to preview birthday photos before the real IST unlock time
# (local dev / Vercel preview only — never set this in Production).
ALLOW_DEV_PREVIEW=true

# Local filesystem fallback for /api/photo during development — points at
# the folder holding Mahii's real private photos. Already git-ignored;
# never commit these images. Leave unset in Production so the API always
# serves from private Blob storage instead.
MAHII_WORLD_PRIVATE_PHOTOS_DIR=local-private-assets/birthday

# Birthday Passcode & Countdown Configuration
# (Passcode Lock steps: DD -> MM -> YYYY)
VITE_BIRTHDAY_DAY=22
VITE_BIRTHDAY_MONTH=08
VITE_BIRTHDAY_YEAR=2007

# Target Countdown Celebration Year (e.g. 2026)
VITE_BIRTHDAY_TARGET_YEAR=2026

# Optional: Exact ISO countdown target override
# VITE_BIRTHDAY_TARGET_DATE=2026-08-22T00:00:00
